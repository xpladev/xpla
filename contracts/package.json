{
  "name": "@xpla/contracts",
  "version": "1.9.0-rc2",
  "description": "A collection of smart contracts used in the development of the CONX Chain.",
  "dependencies": {
    "cosmos-evm-contracts": "^0.0.1"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "hardhat": "^3.1.5"
  },
  "files": [
    "**/*.sol",
    "artifacts/solidity/precompiles/**/*.json"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "prepack": "pnpm run compile && find artifacts -name 'artifacts.d.ts' -delete && node scripts/prepack-publish.mjs",
    "postpack": "node scripts/prepack-publish.mjs --restore"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpladev/xpla.git"
  },
  "author": "DELIGHT LABS",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xpladev/xpla/issues"
  },
  "homepage": "https://github.com/xpladev/xpla/blob/main/contracts/README.md",
  "packageManager": "pnpm@9.15.0"
}
