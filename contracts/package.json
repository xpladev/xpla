{
  "name": "@xpla/contracts",
  "version": "1.9.0-rc5",
  "description": "A collection of smart contracts used in the development of the CONX Chain.",
  "dependencies": {
    "cosmos-evm-contracts": "^0.0.8"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "hardhat": "^3.1.5",
    "typescript": "^5.1.6"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./*.sol": "./dist/*.sol",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build:precompiles": "node scripts/build-precompiles.js && pnpm exec tsc -p tsconfig.json",
    "compile": "hardhat compile",
    "prepublishOnly": "pnpm run build:precompiles"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpladev/xpla.git"
  },
  "author": "DELIGHT LABS",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xpladev/xpla/issues"
  },
  "homepage": "https://github.com/xpladev/xpla/blob/main/contracts/README.md",
  "packageManager": "pnpm@9.15.0"
}
